# API du kanban commercial — variables d'environnement.
#
# En local : copier en .env et renseigner DATABASE_URL.
# Sur Coolify : saisir ces variables dans l'onglet « Environment Variables ».

# --- Base de données (obligatoire) ---
# Sur Coolify, utiliser l'URL interne du service PostgreSQL :
# postgres://user:motdepasse@nom-du-service:5432/base
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE:5432/kanban_commercial?schema=public"

# Port d'écoute (4000 par défaut).
# PORT=4000

# Origines autorisées à appeler l'API, séparées par des virgules :
# en production, l'URL publique de l'interface.
# CORS_ORIGINES="https://kanban.exemple.com"

# --- Authentification Keycloak ---
# Sans KEYCLOAK_ISSUER, l'API accepte un en-tête `x-utilisateur` désignant le
# compte : mode local de développement, à ne jamais exposer publiquement.
# KEYCLOAK_ISSUER="https://plateform-auth.exemple.com/realms/NOM_DU_REALM"
# KEYCLOAK_CLIENT_ID="kanban-commercial"
#
# Rôle Keycloak ouvrant l'accès (défaut : kanban-commercial). Le rôle métier —
# commercial, LLD, manager, direction — reste géré ici et rapproché par e-mail.
# KEYCLOAK_ROLE_ACCES="kanban-commercial"

# --- Synchronisation avec le CRM (facultatif) ---
# Sans ces variables, la synchronisation reste inactive.
#
# API HTTP de management du bus RabbitMQ (et non le port AMQP).
# RABBITMQ_MGMT_URL="https://rabbitmq.exemple.com"
# En-tête Host à forcer lorsque l'URL pointe une IP derrière un proxy.
# RABBITMQ_HOST_HEADER=""
# RABBITMQ_VHOST=""
# RABBITMQ_USER=""
# RABBITMQ_PASSWORD=""
# RABBITMQ_QUEUE="kanban.events.in"
# RABBITMQ_EXCHANGE=""
# RABBITMQ_BINDINGS="crm.clients.*,crm.client_contacts.*"

# Secret protégeant POST /api/synchro. Sans lui, la route refuse tout appel :
# mieux vaut une synchronisation inactive qu'un point d'écriture ouvert.
# SYNCHRO_SECRET=""

# Racine du CRM : reprise initiale des clients, et lecture des devis.
# Le bus ne publie que les modifications : les clients déjà en base n'en
# émettent aucune. Utilisée par `npm run crm:reprise`, une seule fois, et par
# la fiche opportunité, qui lit les devis du client à la demande — plus de
# 400 000 en base, jamais synchronisés.
# CRM_URL="https://crm.exemple.com"
